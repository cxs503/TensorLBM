      "reynolds": 5600,
      "analytical": false,
      "reference": "Moser1999"
    },
    {
      "id": "TC09",
      "name": "acoustic_pulse_2d",
      "physics": "acoustic",
      "lattice": "D2Q9",
      "collision": "BGK",
      "description": "2D acoustic pulse propagation",
      "analytical": true
    },
    {
      "id": "TC10",
      "name": "cylinder_drag_2d",
      "physics": "single_phase",
      "lattice": "D2Q9",
      "collision": "RLBM",
      "description": "2D flow past cylinder, Re=100",
      "reynolds": 100,
      "analytical": false,
      "reference": "Schaefer1996"
    }
  ],
  "coverage_targets": {
    "lattice_coverage": 1.0,
    "collision_coverage": 0.8,
    "physics_coverage": 0.75,
    "boundary_coverage": 0.6
  }
}
