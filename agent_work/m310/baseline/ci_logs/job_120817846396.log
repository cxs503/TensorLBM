2026-10-24T08:30:30.7960473Z 
2026-10-24T08:30:30.7960588Z     def test_navier_slip_mass_conservation():
2026-10-24T08:30:30.7960900Z         """Test that Navier slip BC conserves mass."""
2026-10-24T08:30:30.7961301Z         device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
2026-10-24T08:30:30.7961666Z     
2026-10-24T08:30:30.7961842Z         # Setup
2026-10-24T08:30:30.7962040Z         nz, ny, nx = 4, 21, 16
2026-10-24T08:30:30.7962374Z         rho_init = torch.ones((nz, ny, nx), dtype=torch.float32, device=device)
2026-10-24T08:30:30.7962902Z         ux_init = torch.zeros_like(rho_init)
2026-10-24T08:30:30.7963199Z         uy_init = torch.zeros_like(rho_init)
2026-10-24T08:30:30.7963473Z         uz_init = torch.zeros_like(rho_init)
2026-10-24T08:30:30.7963863Z     
2026-10-24T08:30:30.7964093Z         f = equilibrium3d(rho_init, ux_init, uy_init, uz_init)
2026-10-24T08:30:30.7964395Z     
2026-10-24T08:30:30.7964561Z         # Wall masks
2026-10-24T08:30:30.7964878Z         bottom_mask = torch.zeros((nz, ny, nx), dtype=torch.bool, device=device)
2026-10-24T08:30:30.7965246Z         bottom_mask[:, 0, :] = True
2026-10-24T08:30:30.7965591Z         top_mask = torch.zeros((nz, ny, nx), dtype=torch.bool, device=device)
2026-10-24T08:30:30.7965968Z         top_mask[:, -1, :] = True
2026-10-24T08:30:30.7966194Z     
2026-10-24T08:30:30.7966368Z         # Initial mass
2026-10-24T08:30:30.7966585Z         mass_initial = f.sum().item()
2026-10-24T08:30:30.7966826Z     
2026-10-24T08:30:30.7967015Z         # Apply some flow with Navier slip
2026-10-24T08:30:30.7967289Z         for step in range(100):
2026-10-24T08:30:30.7967546Z             rho, ux, uy, uz = macroscopic3d(f)
2026-10-24T08:30:30.7967844Z             feq = equilibrium3d(rho, ux, uy, uz)
2026-10-24T08:30:30.7968121Z             f = f - (f - feq) / 1.0
2026-10-24T08:30:30.7968367Z             f = stream3d(f)
2026-10-24T08:30:30.7968649Z             f = navier_slip_cells_3d(f, bottom_mask, axis=1, Ls=2.0)
2026-10-24T08:30:30.7969157Z             f = navier_slip_cells_3d(f, top_mask, axis=1, Ls=2.0)
2026-10-24T08:30:30.7969450Z     
2026-10-24T08:30:30.7969617Z         # Final mass
2026-10-24T08:30:30.7969824Z         mass_final = f.sum().item()
2026-10-24T08:30:30.7970059Z     
2026-10-24T08:30:30.7970238Z         # Check mass conservation
2026-10-24T08:30:30.7970505Z         mass_drift = abs(mass_final - mass_initial)
2026-10-24T08:30:30.7970793Z >       assert mass_drift < 1e-6, \
2026-10-24T08:30:30.7971130Z             f"Navier slip should conserve mass, but drift is {mass_drift}"
2026-10-24T08:30:30.7971629Z E       AssertionError: Navier slip should conserve mass, but drift is 0.0001220703125
2026-10-24T08:30:30.7972040Z E       assert 0.0001220703125 < 1e-06
