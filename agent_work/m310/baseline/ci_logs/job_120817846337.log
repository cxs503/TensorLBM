2026-10-24T08:22:18.8404299Z 
2026-10-24T08:22:18.8404533Z     def test_navier_slip_mass_conservation():
2026-10-24T08:22:18.8404945Z         """Test that Navier slip BC conserves mass."""
2026-10-24T08:22:18.8405581Z         device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
2026-10-24T08:22:18.8406045Z     
2026-10-24T08:22:18.8406383Z         # Setup
2026-10-24T08:22:18.8406694Z         nz, ny, nx = 4, 21, 16
2026-10-24T08:22:18.8407170Z         rho_init = torch.ones((nz, ny, nx), dtype=torch.float32, device=device)
2026-10-24T08:22:18.8407864Z         ux_init = torch.zeros_like(rho_init)
2026-10-24T08:22:18.8408266Z         uy_init = torch.zeros_like(rho_init)
2026-10-24T08:22:18.8408670Z         uz_init = torch.zeros_like(rho_init)
2026-10-24T08:22:18.8409066Z     
2026-10-24T08:22:18.8409461Z         f = equilibrium3d(rho_init, ux_init, uy_init, uz_init)
2026-10-24T08:22:18.8409876Z     
2026-10-24T08:22:18.8410150Z         # Wall masks
2026-10-24T08:22:18.8410617Z         bottom_mask = torch.zeros((nz, ny, nx), dtype=torch.bool, device=device)
2026-10-24T08:22:18.8411091Z         bottom_mask[:, 0, :] = True
2026-10-24T08:22:18.8411581Z         top_mask = torch.zeros((nz, ny, nx), dtype=torch.bool, device=device)
2026-10-24T08:22:18.8412122Z         top_mask[:, -1, :] = True
2026-10-24T08:22:18.8412486Z     
2026-10-24T08:22:18.8412804Z         # Initial mass
2026-10-24T08:22:18.8413137Z         mass_initial = f.sum().item()
2026-10-24T08:22:18.8413683Z     
2026-10-24T08:22:18.8414039Z         # Apply some flow with Navier slip
2026-10-24T08:22:18.8414410Z         for step in range(100):
2026-10-24T08:22:18.8414937Z             rho, ux, uy, uz = macroscopic3d(f)
2026-10-24T08:22:18.8415365Z             feq = equilibrium3d(rho, ux, uy, uz)
2026-10-24T08:22:18.8415801Z             f = f - (f - feq) / 1.0
2026-10-24T08:22:18.8416163Z             f = stream3d(f)
2026-10-24T08:22:18.8416538Z             f = navier_slip_cells_3d(f, bottom_mask, axis=1, Ls=2.0)
2026-10-24T08:22:18.8417097Z             f = navier_slip_cells_3d(f, top_mask, axis=1, Ls=2.0)
2026-10-24T08:22:18.8417537Z     
2026-10-24T08:22:18.8417836Z         # Final mass
2026-10-24T08:22:18.8418150Z         mass_final = f.sum().item()
2026-10-24T08:22:18.8418462Z     
2026-10-24T08:22:18.8418811Z         # Check mass conservation
2026-10-24T08:22:18.8419221Z         mass_drift = abs(mass_final - mass_initial)
2026-10-24T08:22:18.8419632Z >       assert mass_drift < 1e-6, \
2026-10-24T08:22:18.8420075Z             f"Navier slip should conserve mass, but drift is {mass_drift}"
2026-10-24T08:22:18.8420695Z E       AssertionError: Navier slip should conserve mass, but drift is 0.0001220703125
2026-10-24T08:22:18.8421254Z E       assert 0.0001220703125 < 1e-06
