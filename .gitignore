# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
src/*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# IDEs/editors
.vscode/
.idea/

# Run outputs
outputs/

# ── Benchmark run artifacts (generated by benchmark/experiment scripts) ──────
# Root-level result / log files
/*.json
/*.log
/*.npy
/log_*.txt

# Archived experiment scripts (ad-hoc debug / benchmark workers)
/_*.py
/test_*.py

# artifacts/ directory — all benchmark run outputs land here
artifacts/runs/
