# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
src/*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# IDEs/editors
.vscode/
.idea/

# Run outputs
outputs/

# ── Benchmark run artifacts (generated by benchmark/experiment scripts) ──────
# Root-level result / log files
/*.json
/*.log
/*.npy
/log_*.txt

# Archived experiment scripts (ad-hoc debug / benchmark workers)
/_*.py
/test_*.py

# artifacts/ directory — all benchmark run outputs land here
artifacts/runs/

# One-off octree debug diagnostics (methods captured in tensorlbm-development skill)
scripts/diag_*.py

# 运行结果目录（不提交）
results/
results_*/
results_bench_*/
sphere_3d_results/
logs_*/
test_screenshots/

# ── Model weights & heavy binaries ──────────────────────────────────────────
# Distribute via GitHub Release assets / HF Hub / Git LFS, never in-tree.
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# ── One-off experiment scripts belong in experiments/archived/, not the root ─
# Guard the repository root only (`/`-anchored) so src/, tests/ and scripts/
# keep tracking their legitimately-named modules.
/*_worker.py
/*_launcher.py
/verify_*.py
/run_*.sh
/launch_*.sh
/rettest_*
/*_test.py

# 一次性诊断脚本
diag_*.py
diagnose_*.py
profile_*.py
sphere_check.py
sphere_focus.py
stability_bench*.py
verify_geier_impl.py
gen_geier.py
geier_cumulant.py
tensorlbm_*_bench.py
tensorlbm_same_grid_bench.py
naca_*.py
after.txt
run_general_sim_acceptance.sh
