    "hypotheses": {
      "H1_grid_convergence": {
        "statement": "The residual C_L amplitude error is a discretisation error that decays with the refinement ladder; the D28->D40 jump is a transient of an under-resolved regime.",
        "prediction": "cl_amp(D48) and cl_amp(D56) sit close to 1.00 and the span |cl_amp(D56)-cl_amp(D48)| / cl_amp(D56) < 3%.",
        "falsified_if": "cl_amp stays >= +10% at BOTH D48 and D56, or the span between the two finest levels is >= 3% (no convergence yet)."
      },
      "H2_turbulence_viscosity_model": {
        "statement": "The error is caused by the collision/relaxation model: MRT relaxation settings, or tau being inconsistent with Re (compressibility/finite-tau error).",
        "prediction": "cl_amp at fixed D40 changes materially (>= 5%) when tau is shifted by lowering U_mean at constant Re.",
        "falsified_if": "cl_amp changes < 2% between D40(tau=0.600) and D40(tau=0.572). Note: DFG 2D-2 is a laminar case - no turbulence model is active by definition, so this hypothesis can only be about tau/MRT, which is what is tested."
      },
      "H3_boundary_distance_blockage": {
        "statement": "The error comes from the discretised geometry/solid boundary: blockage ratio, cylinder mask area, wall distance, or the DFG pressure-probe placement.",
        "prediction": "the discretised mask area deviates from pi*D^2/4 by more than ~1%, or an effective blockage different from 0.2439, or the probe extrapolation is off by more than the observed error share.",
        "falsified_if": "mask area matches pi*D^2/4 within 1% at every level, blockage equals D/H=0.2439, and the probe columns are fluid columns adjacent to the DFG probe positions (inside the stated extrapolation contract).",
        "note": "Blockage and inlet/outlet distances are FIXED by the benchmark definition and may not be tuned; the test is fidelity to the spec, not sensitivity."
      },
      "H4_sampling_window": {
        "statement": "The error is a statistics artifact: start-up transient inside the averaging window, or too short a sampling duration.",
        "prediction": "removing the transient and lengthening the averaging window changes the estimate by far more than the tolerance.",
        "falsified_if": "on the retained window, cl_amp is stable (drift < 2%) across window lengths 6..12 periods, i.e. 12 periods is already enough.",
        "status_at_freeze": "Already measured by m16827 on frozen series: 13.4% of value at D28 is transient contamination, and peak-vs-fundamental contributes a further 1.7%. This mission re-measures it and adds the window-length stability curve; it is NOT expected to be the residual root cause."
      }
    },
    "quantitative_acceptance": {
      "primary_gate": "Cl amplitude error < 10% AND dp error < 5% AND Cd error < 5%, SIMULTANEOUSLY, at the finest converged level.",
      "secondary_gate": "convergence span between the two finest levels < 3% for the reported value of each metric.",
      "tightened_note": "The task states <10% for Cl; the case's own frozen tolerance is 5%. Reported against BOTH. The 5% matrix tolerance is NOT relaxed.",
      "estimator_convention": "cl_amp = fundamental (least-squares) amplitude at the shedding frequency over the transient-free window, transient_periods=5, avg_periods=12 (as fixed by m16827); peak-pick median reported alongside for audit only."
    },
    "decision_rules_predeclared": [
      "If primary_gate AND secondary_gate pass at D56 -> the +35% headline is root-caused as (dominant) estimator/window artifact + (residual) under-resolution; case may be re-scored using the finest converged level, and the minimum documented resolution for this case becomes D56.",
      "If primary_gate passes at D56 but secondary_gate fails -> honest FAIL on convergence; status stays failed; root cause = 'no converged level exists below D56'.",
      "If cl_amp remains >= +10% at D56 -> H1 falsified: the residual error is NOT grid convergence. Escalate to a solver-side defect investigation; record honest FAIL with the ladder as evidence.",
      "Thresholds above are frozen. No threshold, window, level, or metric definition may be changed after inspecting the new results. Any deviation must be logged as a deviation with its reason, and the original criterion preserved in the record."
    ],
